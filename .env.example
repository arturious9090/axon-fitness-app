# Local development only. Copy to .env and replace the secret before running.
DATABASE_URL=postgresql://axon:axon_local_only@localhost:56437/axon
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:8081
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# "test" writes only to the local development mail inbox; "resend" sends real mail.
EMAIL_PROVIDER=test
RESEND_API_KEY=
EMAIL_FROM=Axon Fitness <noreply@example.com>
EMAIL_DAILY_LIMIT=90
EMAIL_MONTHLY_LIMIT=2900
# For a physical Android device, use the development computer's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3000
